{
  "name": "lancerlogin-module-carpool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Carpool ride planning for LancerLogin Modular, packaged as a module plugin.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:core": "node scripts/verify-with-core.mjs --core"
  },
  "lancerlogin": {
    "moduleId": "carpool",
    "contract": 1,
    "core": ">=2.0.0-beta.11 <3.0.0",
    "tablePrefix": "carpool_",
    "entries": {
      "manifest": "./src/manifest.ts",
      "api": "./src/api.ts",
      "dashboard": "./src/dashboard.tsx"
    },
    "migrations": "./migrations",
    "adoptedCoreMigrations": [
      "0049_carpool_module.sql",
      "0058_carpool_meeting_links.sql",
      "0063_carpool_settings.sql",
      "0067_carpool_people_workspace.sql",
      "0068_carpool_groups_workspace.sql",
      "0069_carpool_share_schedule.sql",
      "0074_carpool_location_resolution.sql"
    ]
  },
  "peerDependencies": {
    "@lancerlogin/module-sdk": "^1.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.1"
  }
}
